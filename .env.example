# Chép thành .env.local khi chạy thử trên máy.

# Tên miền gốc, dùng cho canonical và đường dẫn tuyệt đối (docs/07, mục A9).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cờ lập chỉ mục. Để "false" cho tới ngày ra mắt; chỉ anh mới bật.
# Bật mà vẫn còn ảnh tạm trong site.config.ts thì build sẽ báo lỗi.
NEXT_PUBLIC_CHO_PHEP_LAP_CHI_MUC=false

# Bài chưa “da-dang” chỉ hiện ở bản xem trước (docs/04, mục 5; docs/09).
# Production của Vercel và lúc cờ lập chỉ mục bật thì không bao giờ hiện.
# Đặt "false" để dựng thử trên máy đúng như production.
# HIEN_BAN_NHAP=false
